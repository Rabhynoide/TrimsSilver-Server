# Copy this file to .env (local dev) and fill in real values.
# In Docker Compose, these are provided via the `.env` file at the repo root as well.

# Postgres connection string used by Prisma.
# When running via docker-compose, host "db" is the Postgres service name.
DATABASE_URL="postgresql://user:password@localhost:5432/trimssilver?schema=public"

# Auth.js (NextAuth) — generate with: npx auth secret
AUTH_SECRET=""

# Public base URL of this app (used to build OAuth redirect URLs).
AUTH_URL="http://localhost:3000"

# Discord OAuth application — https://discord.com/developers/applications
# Redirect URI to register on the Discord app: {AUTH_URL}/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Comma-separated Discord account ids (the numeric snowflake, not the
# username — enable Developer Mode in Discord, right-click your own name,
# "Copy User ID") auto-promoted to admin + full site access on every sign-in.
# Bootstraps the very first admin with no DB access needed: set this, sign in
# once via Discord, then manage everyone else's access from /admin/users.
ADMIN_DISCORD_IDS=""
