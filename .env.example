# Copy this file to .env (local dev) and fill in real values.
# In Docker Compose, these are provided via the `.env` file at the repo root as well.

# Postgres connection string used by Prisma.
# When running via docker-compose, host "db" is the Postgres service name.
DATABASE_URL="postgresql://trimssilver:trimssilver@localhost:5432/trimssilver?schema=public"

# Auth.js (NextAuth) — generate with: npx auth secret
AUTH_SECRET=""

# Public base URL of this app (used to build OAuth redirect URLs).
AUTH_URL="http://localhost:3000"

# Discord OAuth application — https://discord.com/developers/applications
# Redirect URI to register on the Discord app: {AUTH_URL}/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
