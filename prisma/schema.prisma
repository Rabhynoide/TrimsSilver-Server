// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth.js (NextAuth) Prisma adapter schema — https://authjs.dev/getting-started/adapters/prisma
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketOrders                  MarketOrder[]
  playerCounts                  PlayerCount[]
  achievementSnapshots          AchievementSnapshot[]
  globalMultipliers             GlobalMultiplier[]
  festivitySnapshots            FestivitySnapshot[]
  itemEstimatedMarketValues     ItemEstimatedMarketValue[]
  privateOrderSharesOwned       PrivateOrderShare[]        @relation("PrivateOrderSharesOwned")
  privateOrderSharesResolvedFor PrivateOrderShare[]        @relation("PrivateOrderSharesResolved")
  apiTokens                     ApiToken[]
  marketPriceFavorites          MarketPriceFavorite[]
  farmingCalculatorSettings     FarmingCalculatorSettings?
  craftingCalculatorSettings    CraftingCalculatorSettings?
  journalsCalculatorSettings    JournalsCalculatorSettings?
  craftFinderSettings           CraftFinderSettings?
}

// Bearer token the desktop client sends on ingest requests, minted by a signed-in browser
// session at /api/tokens. Stands in for a full OAuth-device flow until client issue #3 lands.
model ApiToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  label      String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- Private, Discord-authenticated ingest data ---
// The client's public AODP channel (market orders broadcast to pow.*.albion-online-data.com)
// is out of scope here by design — see PROJECT_STATUS.md's architecture decision. Everything
// below backs the 7 private upload types instead, each owned by the authenticated User who
// submitted it (identified server-side via the Auth.js session, not any client-supplied id).

enum AuctionType {
  unknown
  offer
  request
}

// TrimsSilverMarketUpload / old "flipperOrders" endpoint.
// One row per in-game market order, upserted by (serverId, orderId) as a current-state table.
model MarketOrder {
  id                 String      @id @default(cuid())
  orderId            BigInt
  serverId           Int
  itemTypeId         String
  itemGroupTypeId    String
  locationId         String
  qualityLevel       Int
  enchantmentLevel   Int
  unitPriceSilver    BigInt
  amount             Int
  auctionType        AuctionType
  expires            String
  contributeToPublic Boolean     @default(false)
  shareWithFriends   Boolean     @default(false)

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serverId, orderId])
  @@index([serverId, itemTypeId, locationId])
  @@index([uploaderId])
}

// PlayerCount / old "playercount" endpoint. Append-only time series, one row per observation.
model PlayerCount {
  id              String   @id @default(cuid())
  serverId        Int
  locationId      String
  observedAt      DateTime
  nonFlaggedCount Int?
  flaggedCount    Int?
  isBz            Boolean

  submittedById String
  submittedBy   User   @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([serverId, locationId, observedAt])
}

// AchievementUpload / old "be/achievements" endpoint.
// Latest achievement snapshot per (serverId, characterName); entries replaced wholesale on upload.
model AchievementSnapshot {
  id            String @id @default(cuid())
  serverId      Int
  characterName String

  submittedById String
  submittedBy   User   @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  achievements AchievementEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serverId, characterName])
}

model AchievementEntry {
  id            String @id @default(cuid())
  achievementId String
  level         Int

  snapshotId String
  snapshot   AchievementSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, achievementId])
}

// GlobalMultiplierUpload / old "be/globalMultiplier" endpoint.
// Current value per server, upserted on change.
model GlobalMultiplier {
  id       String @id @default(cuid())
  serverId Int    @unique
  value    Float

  submittedById String
  submittedBy   User   @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

// FestivitiesUpload / old "be/festivities" endpoint.
// Current set of active/known events per server; entries replaced wholesale on upload.
model FestivitySnapshot {
  id       String @id @default(cuid())
  serverId Int    @unique

  submittedById String
  submittedBy   User   @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  events FestivityEvent[]

  updatedAt DateTime @updatedAt
}

model FestivityEvent {
  id         String   @id @default(cuid())
  kind       Int
  category   String
  uniqueName String
  startTime  DateTime
  endTime    DateTime

  snapshotId String
  snapshot   FestivitySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, category, uniqueName, startTime])
}

// ItemEstimatedMarketValueUpload / old "itemEstimatedMarketValues" endpoint.
// One row per (serverId, itemUniqueName, quality, day), upserted as clients report EMVs.
model ItemEstimatedMarketValue {
  id             String   @id @default(cuid())
  serverId       Int
  itemUniqueName String
  quality        Int
  day            DateTime @db.Date
  emv            BigInt
  blackMarketEmv BigInt?

  submittedById String
  submittedBy   User   @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serverId, itemUniqueName, quality, day])
}

// PrivateOrderShares / old "privateOrderShares" endpoint (GET/PUT, not a queued upload).
// The list of identifiers an owner has shared their private market orders with.
model PrivateOrderShare {
  id       String  @id @default(cuid())
  value    String
  type     String
  resolved Boolean @default(false)

  ownerId String
  owner   User   @relation("PrivateOrderSharesOwned", fields: [ownerId], references: [id], onDelete: Cascade)

  resolvedUserId String?
  resolvedUser   User?   @relation("PrivateOrderSharesResolved", fields: [resolvedUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, value])
}

// --- Web UI data (not part of the client's 7 private upload types) ---

// A saved Market Prices Price Checker configuration (selected items, cities, display
// options). Browser-only feature, gated on the Auth.js session cookie like the rest of
// the site — not fed by the desktop client's bearer-token ingest routes.
model MarketPriceFavorite {
  id     String  @id @default(cuid())
  name   String
  note   String?
  config Json

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// A saved Farming & Breeding Calculator profile (location, premium, tax/fee,
// market locations, price mode, manual spec overrides). One row per user
// (unlike MarketPriceFavorite, this is a single persisted profile, not a
// named list — matches AFM's own single "Save Settings" control). Browser-only
// feature, gated on the Auth.js session cookie.
model FarmingCalculatorSettings {
  id     String @id @default(cuid())
  config Json

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

// A saved Crafting Calculator profile (region/cities, price mode, Return
// Rate/station fee inputs, Focus/spec settings, manual prices). One row per
// user, same single-profile shape as FarmingCalculatorSettings above.
// Browser-only feature, gated on the Auth.js session cookie.
model CraftingCalculatorSettings {
  id     String @id @default(cuid())
  config Json

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

// A saved Journals Calculator profile (scenario, amount, happiness/yield,
// cities, buy/sell price types, per-family fill choice/manual fill cost,
// manual prices), same single-profile shape as Farming/Crafting above.
// Browser-only feature, gated on the Auth.js session cookie.
model JournalsCalculatorSettings {
  id     String @id @default(cuid())
  config Json

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

// A saved Craft Finder profile (simulation city, Premium, price mode,
// liquidity thresholds, per-category Return Rate/Focus inputs, filters),
// same single-profile shape as Farming/Crafting/Journals above.
// Browser-only feature, gated on the Auth.js session cookie.
model CraftFinderSettings {
  id     String @id @default(cuid())
  config Json

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

// Server-side cache of AODP's public current-price API, kept warm by a
// background sync job (src/lib/priceCacheSync.ts, started once per server
// instance from src/instrumentation.ts) instead of every user request
// live-proxying AODP. Scoped to the item universes that get queried in full
// on every refresh: Farming and Journals' whole catalogs (~650 items,
// quality 1 only — farmables/journal materials never vary quality), and
// Craft Finder's whole equipment catalog at enchant 0 (768 items, quality 1
// only — Craft Finder ranks quality 1 exclusively, per its own scope) plus
// its whole resource-refining catalog (also quality 1 only) — a
// craft-profitability ranking inherently needs the full catalog priced.
// NOT Crafting's or Market Prices' catalogs, which are queried selectively
// (one item's recipe, or whatever the user picks) rather than fully every
// time, so caching their entire catalogs (Crafting alone is ~3,900
// craft-item-ids × 5 qualities × 8 cities) would be wasteful and mostly
// unused — same reasoning that keeps Craft Finder's own enchant 1-4
// variants out of this cache too (see craft-finder-constants.ts). Those
// stay live-proxied exactly as before; date fields are kept as the raw
// AODP string (not DateTime) since that's the convention this codebase
// already uses everywhere else for these values (see PriceRow in
// market-prices/types.ts) — never parsed into a real Date server-side.
model CachedMarketPrice {
  id     String @id @default(cuid())
  itemId String
  city   String
  // Always 1 for this cache's universe (see above), kept as a real column
  // rather than hardcoded so the schema doesn't lie if that ever changes.
  quality Int
  region  String

  sellPriceMin     Int
  sellPriceMinDate String
  sellPriceMax     Int
  sellPriceMaxDate String
  buyPriceMin      Int
  buyPriceMinDate  String
  buyPriceMax      Int
  buyPriceMaxDate  String

  updatedAt DateTime @updatedAt

  @@unique([itemId, city, quality, region])
  @@index([region])
}
